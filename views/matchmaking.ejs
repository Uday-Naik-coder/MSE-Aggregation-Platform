<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Matchmaking · MSE Connect</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    /* ===== GLOBAL VARIABLES ===== */
    :root {
      --saffron: #FF6B35;
      --deep-navy: #0D1B2A;
      --teal: #00897B;
      --teal-light: #00BFA5;
      --gold: #FFB300;
      --cream: #FFF8F0;
      --text-main: #1a1a2e;
      --text-muted: #6b7280;
      --card-bg: #ffffff;
      --border: #e5e7eb;
      --sidebar-width: 260px;
      --shadow-sm: 0 8px 20px rgba(0,0,0,0.02), 0 2px 6px rgba(0,20,10,0.05);
      --shadow-hover: 0 20px 30px -10px rgba(0,100,80,0.15);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--deep-navy);
      color: var(--text-main);
      height: 100vh;
      overflow: hidden;
    }

    .dashboard-container {
      display: flex;
      height: 100%;
      width: 100%;
      animation: fadeIn 0.6s ease;
    }

    /* ---------- SIDEBAR (same as before) ---------- */
    .sidebar {
      width: var(--sidebar-width);
      background: var(--deep-navy);
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 28px 16px 20px;
      border-right: 1px solid rgba(255,255,255,0.05);
      box-shadow: 8px 0 30px rgba(0,0,0,0.3);
      z-index: 10;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--teal) var(--deep-navy);
    }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-track { background: var(--deep-navy); }
    .sidebar::-webkit-scrollbar-thumb { background: var(--teal); border-radius: 20px; }

    .sidebar::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 100% 70% at 30% 20%, rgba(0,137,123,0.18) 0%, transparent 70%);
      pointer-events: none;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 36px;
      padding-left: 8px;
      position: relative;
      z-index: 2;
      animation: slideDown 0.5s;
    }
    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--saffron), var(--gold));
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(255,107,53,0.3);
    }
    .brand-icon svg { width: 22px; height: 22px; fill: white; }
    .brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 18px;
      color: white;
      letter-spacing: 0.02em;
    }
    .brand-name span { color: var(--gold); }

    .role-chip {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,179,0,0.2);
      border-radius: 40px;
      padding: 8px 14px;
      margin: 0 0 28px 0;
      display: flex;
      align-items: center;
      gap: 8px;
      color: white;
      font-size: 13px;
      font-weight: 500;
      backdrop-filter: blur(4px);
    }
    .role-chip .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 8px var(--gold);
      animation: pulse 2s infinite;
    }
    @keyframes pulse { 0% { opacity:1; } 50% { opacity:0.5; } }

    .nav-menu {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 6px;
      position: relative;
      z-index: 2;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 12px;
      color: rgba(255,255,255,0.65);
      transition: all 0.2s ease;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
    }
    .nav-item.active {
      background: linear-gradient(90deg, rgba(0,137,123,0.2) 0%, rgba(0,191,165,0.1) 100%);
      color: white;
      border-left: 3px solid var(--gold);
    }
    .nav-item:not(.active):hover {
      background: rgba(255,255,255,0.03);
      color: white;
      transform: translateX(5px);
    }
    .nav-item svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
    }

    .user-profile {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      gap: 10px;
      position: relative;
      z-index: 2;
    }
    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: linear-gradient(145deg, var(--teal), #004D40);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 16px;
      text-transform: uppercase;
    }
    .user-info {
      flex:1;
    }
    .user-name {
      color: white;
      font-weight: 600;
      font-size: 14px;
    }
    .user-email {
      color: rgba(255,255,255,0.45);
      font-size: 11px;
    }
    .logout-link {
      color: var(--gold);
      font-size: 12px;
      text-decoration: none;
      display: inline-block;
      margin-top: 4px;
    }
    .logout-link:hover {
      text-decoration: underline;
    }

    /* ---------- MAIN CONTENT ---------- */
    .main-content {
      flex: 1;
      background: var(--cream);
      overflow-y: auto;
      padding: 24px 32px;
      position: relative;
    }
    .main-content::before {
      content: '';
      position: absolute;
      top: -50px;
      right: -50px;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,107,53,0.04), transparent 80%);
      pointer-events: none;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 30px;
      animation: slideUp 0.5s 0.1s both;
    }
    .header-left h2 {
      font-family: 'Playfair Display', serif;
      font-size: 26px;
      color: var(--text-main);
    }
    .header-left p {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .card {
      background: var(--card-bg);
      border-radius: 24px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
      border: 1px solid rgba(0,0,0,0.02);
      transition: box-shadow 0.3s;
      animation: slideUp 0.5s both;
      margin-bottom: 24px;
    }
    .card:hover { box-shadow: var(--shadow-hover); }
    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .card-header h3 {
      font-size: 20px;
      font-weight: 600;
      color: var(--text-main);
    }
    .card-header a {
      color: var(--teal);
      font-size: 14px;
      text-decoration: none;
      font-weight: 500;
    }

    /* Filter bar */
    .filter-bar {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      flex-wrap: wrap;
      background: white;
      padding: 16px 20px;
      border-radius: 50px;
      box-shadow: var(--shadow-sm);
    }
    .filter-bar select, .filter-bar input {
      padding: 10px 16px;
      border-radius: 30px;
      border: 1px solid var(--border);
      background: white;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      outline: none;
      flex: 1 1 160px;
    }
    .filter-bar button {
      background: var(--teal);
      color: white;
      border: none;
      padding: 10px 28px;
      border-radius: 30px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.15s;
    }
    .filter-bar button:hover { background: #00695c; }

    /* Supplier / buyer cards */
    .entity-card {
      background: #faf7f2;
      border-radius: 20px;
      padding: 18px;
      margin-bottom: 16px;
      border: 1px solid var(--border);
      transition: 0.2s;
    }
    .entity-card:hover {
      box-shadow: var(--shadow-hover);
      transform: translateY(-2px);
    }
    .entity-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .entity-header h4 {
      font-size: 18px;
      font-weight: 600;
    }
    .badge {
      background: var(--teal-light);
      color: white;
      padding: 4px 12px;
      border-radius: 30px;
      font-size: 12px;
    }
    .entity-details {
      color: var(--text-muted);
      font-size: 14px;
      margin-bottom: 12px;
    }
    .connect-btn {
      background: var(--gold);
      border: none;
      padding: 8px 20px;
      border-radius: 30px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.15s;
    }
    .connect-btn:hover { background: #e0a800; transform: scale(0.98); }

    @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
    @keyframes slideDown { from { opacity:0; transform: translateY(-15px); } to { opacity:1; transform: translateY(0); } }
    @keyframes slideUp { from { opacity:0; transform: translateY(20px); } to { opacity:1; transform: translateY(0); } }
  </style>
</head>
<body>
  <div class="dashboard-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div class="brand-name">MSE<span>Connect</span></div>
      </div>
      <div class="role-chip">
        <span class="dot"></span>
        <span>Logged in as <strong><%= user.role === 'seller' ? 'Seller' : 'Buyer' %></strong></span>
      </div>
      <div class="nav-menu">
        <a href="/dashboard" class="nav-item">
          <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Dashboard</span>
        </a>
        <a href="/inventory-twin" class="nav-item">
          <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M12 22V12"/><path d="M9 10.5l3-1.5 3 1.5"/></svg>
          <span>Inventory Twin</span>
        </a>
        <a href="/demand-forecast" class="nav-item">
          <svg viewBox="0 0 24 24"><path d="M2 16.1A5 5 0 0 1 5.9 20M2 12.05A9 9 0 0 1 9.95 20M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"/><line x1="2" y1="20" x2="2.01" y2="20"/></svg>
          <span>Demand Forecast</span>
        </a>
        <a href="/matchmaking" class="nav-item active">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span>Matchmaking</span>
        </a>
        <a href="/logistics" class="nav-item">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Logistics</span>
        </a>
        <a href="/crm" class="nav-item">
          <svg viewBox="0 0 24 24"><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h10.5"/><polyline points="16 2 22 8 16 8"/><line x1="10" y1="14" x2="21" y2="14"/><line x1="10" y1="18" x2="18" y2="18"/></svg>
          <span>CRM / Loyalty</span>
        </a>
        <a href="/payments" class="nav-item">
          <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M22 10h-6"/></svg>
          <span>Payments & Subsidy</span>
        </a>
      </div>
      <div class="user-profile">
        <div class="avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div class="user-info">
          <div class="user-name"><%= user.name %></div>
          <div class="user-email"><%= user.email %></div>
          <a href="/logout" class="logout-link">Logout</a>
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
      <div class="header">
        <div class="header-left">
          <h2><%= user.role === 'seller' ? '🤝 Find Buyers' : '🏭 Find Suppliers' %></h2>
          <p>AI‑powered matching based on quality, capacity & location</p>
        </div>
      </div>

      <!-- Filter bar -->
      <div class="filter-bar">
        <input type="text" placeholder="Search by name or product">
        <select>
          <option>Category: All</option>
          <option>Pottery</option>
          <option>Textile</option>
          <option>Handicrafts</option>
          <option>Brass</option>
        </select>
        <select>
          <option>Rating: Any</option>
          <option>4+ ★</option>
          <option>4.5+ ★</option>
        </select>
        <select>
          <option>Location: Jaipur</option>
          <option>Ajmer</option>
          <option>Jodhpur</option>
        </select>
        <button>Apply Filters</button>
      </div>

      <!-- Results (role‑aware) -->
      <% if (user.role === 'seller') { %>
        <!-- Seller view: showing buyers -->
        <div class="entity-card">
          <div class="entity-header">
            <h4>FabIndia B2B</h4>
            <span class="badge">ODOP</span>
          </div>
          <div class="entity-details">⭐ 4.9 (230 orders) · Bulk buyer · GeM registered · Immediate payment</div>
          <button class="connect-btn">Connect</button>
        </div>

        <div class="entity-card">
          <div class="entity-header">
            <h4>Jaipur Handicrafts Export</h4>
            <span class="badge">Export</span>
          </div>
          <div class="entity-details">⭐ 4.8 (87 orders) · International buyer · Requires large quantities</div>
          <button class="connect-btn">Connect</button>
        </div>

        <div class="entity-card">
          <div class="entity-header">
            <h4>GeM Buyer (Govt.)</h4>
            <span class="badge">Tender</span>
          </div>
          <div class="entity-details">⭐ 5.0 (12 orders) · Govt. e‑marketplace · Pottery required</div>
          <button class="connect-btn">Connect</button>
        </div>

        <div class="entity-card">
          <div class="entity-header">
            <h4>Amber Crafts</h4>
            <span class="badge">Local</span>
          </div>
          <div class="entity-details">⭐ 4.5 (45 orders) · Jaipur based · Seeking regular supply</div>
          <button class="connect-btn">Connect</button>
        </div>

      <% } else { %>
        <!-- Buyer view: showing suppliers -->
        <div class="entity-card">
          <div class="entity-header">
            <h4>Neeraj Potteries</h4>
            <span class="badge">ODOP</span>
          </div>
          <div class="entity-details">⭐ 4.7 · 5km away · Capacity: 500 units/week · Blue pottery specialist</div>
          <button class="connect-btn">Request Quote</button>
        </div>

        <div class="entity-card">
          <div class="entity-header">
            <h4>Kumbhar MSE</h4>
            <span class="badge">JIT enabled</span>
          </div>
          <div class="entity-details">⭐ 4.9 · 12km away · Low stock alert · Fast delivery</div>
          <button class="connect-btn">Request Quote</button>
        </div>

        <div class="entity-card">
          <div class="entity-header">
            <h4>Blue Pottery Hub</h4>
            <span class="badge">GeM seller</span>
          </div>
          <div class="entity-details">⭐ 4.8 · 8km away · 2‑day dispatch · Bulk orders accepted</div>
          <button class="connect-btn">Request Quote</button>
        </div>

        <div class="entity-card">
          <div class="entity-header">
            <h4>Terracotta World</h4>
            <span class="badge">ODOP</span>
          </div>
          <div class="entity-details">⭐ 4.6 · 15km away · Specialises in lamps and decor</div>
          <button class="connect-btn">Request Quote</button>
        </div>
      <% } %>

      <!-- Pagination (static) -->
      <div style="display: flex; justify-content: center; gap: 8px; margin-top: 24px;">
        <span style="background: var(--teal); color: white; padding: 6px 14px; border-radius: 30px;">1</span>
        <span style="background: white; padding: 6px 14px; border-radius: 30px; border:1px solid var(--border);">2</span>
        <span style="background: white; padding: 6px 14px; border-radius: 30px; border:1px solid var(--border);">3</span>
        <span style="background: white; padding: 6px 14px; border-radius: 30px; border:1px solid var(--border);">...</span>
      </div>
    </main>
  </div>
</body>
</html>